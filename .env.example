# ==================================================
# WEBCRAFT — EXAMPLE ENVIRONMENT CONFIGURATION
# ==================================================

# Server & Database Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/WEBCRAFT
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Authentication & JWT Keys
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Smart 2-Way Synergy Matching Formula Parameters & Weights
MATCH_SYNERGY_RECIPROCAL_POINTS=45
MATCH_SYNERGY_TEACH_ONLY_POINTS=25
MATCH_SYNERGY_LEARN_ONLY_POINTS=25
MATCH_SYNERGY_SCHEDULE_POINTS=25
MATCH_SYNERGY_FORMAT_POINTS=15
MATCH_SYNERGY_TRUST_HIGH_POINTS=15
MATCH_SYNERGY_TRUST_MID_POINTS=10
MATCH_SYNERGY_TRUST_LOW_POINTS=5

# Platform Safety & Reputation Policy Parameters
REPUTATION_INITIAL_SCORE=95
REPUTATION_COMPLETION_BONUS=2
EXCHANGE_DEFAULT_PROPOSED_HOURS=2
POLLING_INTERVAL_MS=3000

# Video Calling & External Services Integration
VIDEO_CALL_SERVER_URL=https://meet.jit.si/skillnexus

# External AI Provider Configuration
AI_LLM_API_KEY=your_nvidia_llm_api_key_here
AI_MODEL=meta/llama-3.1-70b-instruct
AI_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

